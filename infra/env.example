# OfferLoop configuration (all vars prefixed OFFERLOOP_)
# Copy to backend/.env for local development, or set on Cloud Run.

# --- mode ------------------------------------------------------------------
# demo  = in-memory store + seeded workspace + deterministic writer (no creds)
# live  = Firestore + Firebase Auth + Gemini
OFFERLOOP_APP_MODE=demo

# --- GCP (live mode) -------------------------------------------------------
OFFERLOOP_GCP_PROJECT=your-project-id
OFFERLOOP_FIRESTORE_DATABASE=(default)

# --- Gemini ----------------------------------------------------------------
# Option A (production): Vertex AI with the service account's ADC
OFFERLOOP_USE_VERTEX=true
OFFERLOOP_VERTEX_LOCATION=global
# Option B (quick start): a Gemini API key from https://aistudio.google.com
# OFFERLOOP_GEMINI_API_KEY=...

# Model routing — Flash for volume, Pro for the cover letter, with fallbacks
OFFERLOOP_MODEL_FLASH=gemini-3.7-flash
OFFERLOOP_MODEL_PRO=gemini-3.1-pro-preview
OFFERLOOP_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite
OFFERLOOP_MODEL_EMBED=gemini-embedding-001

# --- Firebase Auth (live mode) ---------------------------------------------
# The web app config JSON from Firebase console → Project settings.
OFFERLOOP_FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."}

# --- Nudge cadence (product knobs) -----------------------------------------
OFFERLOOP_FOLLOW_UP_BACKOFF_DAYS=5,7,10
OFFERLOOP_INTERVIEW_THANK_YOU_DAYS=1
OFFERLOOP_OFFER_RESPONSE_DAYS=3
OFFERLOOP_REJECT_FEEDBACK_DAYS=2
OFFERLOOP_GHOST_AFTER_DAYS=21
OFFERLOOP_MAX_GENERATED_PER_SCAN=25

# --- Cloud Scheduler (live mode) -------------------------------------------
# The scan endpoint fails closed unless BOTH are set: it only accepts OIDC
# tokens minted for the service URL by this service account.
OFFERLOOP_SCHEDULER_SERVICE_ACCOUNT=offerloop-scheduler@your-project-id.iam.gserviceaccount.com
OFFERLOOP_PUBLIC_URL=https://offerloop-xxxx.a.run.app
